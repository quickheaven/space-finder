{
  "name": "space-finder-api",
  "version": "1.0.0",
  "main": "dist/lib/index.js",
  "bin": {
    "space-finder": "dist/bin/space-finder.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest --passWithNoTests",
    "test-services": "jest --passWithNoTests test/services",
    "test-infra": "jest --passWithNoTests test/MonitorStack.test.ts",
    "watch": "tsc -w",
    "predeploy": "pnpm --filter space-finder-ui build",
    "deploy": "cdk deploy --all --outputs-file ../../packages/cdk-outputs/outputs.json",
    "cdk": "cdk",
    "lint": "eslint .",
    "format": "prettier --write \"bin/**/*.ts\" \"lib/**/*.ts\"",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-amplify/auth": "catalog:",
    "aws-cdk-lib": "catalog:",
    "@aws-sdk/client-cognito-identity": "catalog:",    
    "@aws-sdk/client-dynamodb": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/credential-providers": "catalog:",
    "@aws-sdk/lib-dynamodb": "catalog:",
    "@aws-sdk/util-dynamodb": "catalog:",        
    "constructs": "catalog:",
    "dotenv": "catalog:",
    "source-map-support": "catalog:",
    "@types/uuid": "catalog:",
    "aws-amplify": "catalog:",
    "aws-xray-sdk-core": "catalog:",    
    "uuid": "catalog:"    
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/aws-lambda": "catalog:",        
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "aws-cdk": "catalog:",
    "esbuild": "catalog:",    
    "eslint": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:"
  }
}
