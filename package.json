{
  "name": "aws-typescript-cdk-serverless-react",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "validate": "pnpm lint && pnpm format && pnpm check-types",
    "prepare": "husky"
  },
  "devDependencies": {
    "esbuild": "catalog:",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "turbo": "^2.9.5",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=18"
  }
}
